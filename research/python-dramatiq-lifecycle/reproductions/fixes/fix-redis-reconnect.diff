@@ -333,6 +333,12 @@ class Consumer:
     Consumers and their MessageProxies are *not* thread-safe.
     """
 
+    #: Whether the broker puts this consumer's unacked messages back on
+    #: their queues when the connection is lost.  When it doesn't, the
+    #: messages a consumer thread holds in memory must not be dropped
+    #: after a connection error.
+    redelivers_unacked_on_disconnect = True
+
     def __iter__(self) -> Self:  # pragma: no cover
         """Returns this instance as a Message iterator."""
         return self
