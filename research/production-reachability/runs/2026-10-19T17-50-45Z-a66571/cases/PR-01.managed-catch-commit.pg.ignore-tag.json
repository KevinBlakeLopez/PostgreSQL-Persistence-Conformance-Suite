  "fault": {
    "category": "A",
    "mechanism": "A unique_violation raised by PostgreSQL inside the transaction, and caught by the application. No statement is withheld or rewritten.",
    "injection_point": "After the first write, before the transaction API finishes.",
    "expected_server": "The failed statement aborts the transaction unless the application has recovered through a savepoint. This variant does not create a savepoint.",
    "expected_client": "The application catches 23505. The framework then finishes the transaction through its ordinary API.",
    "depends_on_internals": false
  },
  "knowledge": "The application caught the unique violation. Whether PostgreSQL's later reply is visible depends on the driver and the framework.",
