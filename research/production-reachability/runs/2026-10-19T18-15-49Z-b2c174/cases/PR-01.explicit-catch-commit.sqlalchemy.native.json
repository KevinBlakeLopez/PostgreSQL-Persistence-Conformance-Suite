  "fault": {
    "category": "A",
    "mechanism": "A unique_violation raised by PostgreSQL inside the transaction, and caught by the application. The application then calls the explicit commit API.",
    "injection_point": "After the first write, before the explicit commit.",
    "expected_server": "The failed statement aborts the transaction. No savepoint is created.",
    "expected_client": "The application catches 23505 and calls commit.",
    "depends_on_internals": false
  },
  "knowledge": "The application caught the unique violation and then called the framework's commit method.",
  "api_outcome": {
    "reported": "failed",
    "basis": "SessionTransaction.commit() raised",
    "contract": "Session.begin() returns a SessionTransaction. Transaction.commit() commits it and Transaction.rollback() rolls it back. Session.begin_nested() begins a SAVEPOINT. A returned commit() is the ORM's report that the transaction committed. psycopg Connection.commit executes COMMIT and does not read the command tag.",
    "error": {
      "class": "PendingRollbackError",
      "code": null,
      "message": "This Session's transaction has been rolled back due to a previous exception during flush. To begin a new transaction with this Session, first issue Session.rollback(). Original exception was: (psycopg.errors.UniqueViolation) duplicate key value violates unique constraint \"uniq_code_key\" DETAIL: Key (code)=(taken) already exists. [SQL: INSERT INTO uniq (code) VALUES (%(code)s::VARCHAR) RETURNING uniq.id] [parameters: {'code': 'taken'}] (Background on this error at: https://sqlalche.me/e/21/gkpj) "
    },
    "steps": {
      "variant": "explicit",
      "violation": {
        "class": "IntegrityError",
        "code": "23505",
        "message": "(psycopg.errors.UniqueViolation) duplicate key value violates unique constraint \"uniq_code_key\" DETAIL: Key (code)=(taken) already exists. [SQL: INSERT INTO uniq (code) VALUES (%(code)s::VARCHAR) RETURNING uniq.id] [parameters: {'code': 'taken'}] (Background on this error at: https://sqlalche.me/e/21/gkpj)"
      },
