  "fault": {
    "category": "A",
    "mechanism": "A unique_violation raised by PostgreSQL and allowed to leave the transaction callback.",
    "injection_point": "After the first write, inside the transaction callback.",
    "expected_server": "The failed statement aborts the transaction. The framework's ordinary error path ends it.",
    "expected_client": "The unique violation leaves the transaction API.",
    "depends_on_internals": false
  },
  "knowledge": "The application did not catch the database error. This is the framework's ordinary failure path.",
  "api_outcome": {
    "reported": "rolled_back",
    "basis": "db.transaction().execute(callback) rejected with the error the callback threw",
    "contract": "Kysely 0.29.6 db.transaction().execute(callback) (TransactionBuilder.execute) calls driver.beginTransaction, awaits the callback, then driver.commitTransaction. PostgresDriver.commitTransaction executes the SQL 'commit' and does not read a command tag. If that call resolves, execute sets its internal isCommitted flag and resolves with the callback's result. If the callback throws, it calls rollbackTransaction and rethrows.",
    "error": {
      "class": "DatabaseError",
      "code": "23505",
      "message": "duplicate key value violates unique constraint \"uniq_code_key\""
    },
    "steps": {
      "variant": "control",
      "violation": {
        "class": "DatabaseError",
        "code": "23505",
        "message": "duplicate key value violates unique constraint \"uniq_code_key\""
      },
