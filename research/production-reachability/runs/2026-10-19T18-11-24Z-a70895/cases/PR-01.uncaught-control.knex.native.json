  "fault": {
    "category": "A",
    "mechanism": "A unique_violation raised by PostgreSQL and allowed to leave the transaction callback.",
    "injection_point": "After the first write, inside the transaction callback.",
    "expected_server": "The failed statement aborts the transaction. The framework's ordinary error path ends it.",
    "expected_client": "The unique violation leaves the transaction API.",
    "depends_on_internals": false
  },
  "knowledge": "The application did not catch the database error. This is the framework's ordinary failure path.",
  "api_outcome": {
    "reported": "rolled_back",
    "basis": "knex.transaction(callback) rejected with the error the callback threw",
    "contract": "Knex 3.3.0 transaction(callback) (lib/execution/transaction.js) runs the callback and, when its promise resolves, calls commit(), which runs query(conn, 'COMMIT;', 1, value). That resolves the transaction promise with the callback's value when the query promise resolves. The query result's command tag is not consulted. A rejection of the callback runs ROLLBACK and rejects with that error.",
    "error": {
      "class": "DatabaseError",
      "code": "23505",
      "message": "insert into \"uniq\" (\"code\") values ($1) - duplicate key value violates unique constraint \"uniq_code_key\""
    },
