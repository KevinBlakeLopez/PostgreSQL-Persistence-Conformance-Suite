  "fault": {
    "category": "A",
    "mechanism": "A unique_violation raised by PostgreSQL inside a savepoint. The application rolls back to that savepoint and commits the outer transaction. No statement is withheld or rewritten.",
    "injection_point": "Inside the savepoint, after the outer write.",
    "expected_server": "ROLLBACK TO SAVEPOINT undoes the failed statement. The outer COMMIT can commit the earlier write.",
    "expected_client": "The application uses the framework's savepoint API to recover, then commits.",
    "depends_on_internals": false
  },
  "knowledge": "A committed outer transaction after a rolled-back savepoint is a successful recovery, not a commit of an aborted transaction.",
  "api_outcome": {
    "reported": "committed",
    "basis": "em.transactional(callback) resolved",
    "contract": "In MikroORM 7.2.5, em.transactional(callback) runs the callback, flushes, and commits (AbstractSqlConnection.transactional: begin, callback, commit, return); if the callback or the flush throws, it rolls back and rethrows. A resolved call is MikroORM's report that the transaction committed. The driver result of COMMIT is not read.",
    "error": null,
    "steps": {
      "variant": "savepoint",
      "savepoint": {
