{
  "manifest": "ppcs-adapter/1",
  "name": "kysely",
  "framework": "kysely",
  "description": "Kysely 0.29.6 PostgresDialect on the pg client already installed for MikroORM. No query method is patched.",
  "command": ["node", "main.mjs"],
  "modes": [
    {
      "id": "native",
      "kind": "native",
      "description": "db.transaction().execute(callback) and db.startTransaction().execute()."
    }
  ],
  "implements": [
    "CTL-01.commit",
    "CTL-01.rollback",
    "PR-01.managed-catch-commit",
    "PR-01.explicit-catch-commit",
    "PR-01.uncaught-control",
    "PR-01.savepoint-recovery"
  ],
  "rollback_claim_channels": [],
  "unsupported": {}
}
