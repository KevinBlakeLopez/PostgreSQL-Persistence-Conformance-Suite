diff --git a/tortoise/backends/asyncpg/client.py b/tortoise/backends/asyncpg/client.py
index 4101f71..2f34a59 100644
--- a/tortoise/backends/asyncpg/client.py
+++ b/tortoise/backends/asyncpg/client.py
@@ -199,7 +199,12 @@ class TransactionWrapper(AsyncpgDBClient, TransactionalDBClient):
             raise TransactionManagementError("Transaction is in invalid state")
