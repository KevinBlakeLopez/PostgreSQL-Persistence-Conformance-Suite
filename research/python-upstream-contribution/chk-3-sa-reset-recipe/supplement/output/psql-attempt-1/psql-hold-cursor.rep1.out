== 2. control: a WITH HOLD cursor, then a block that rolls back with nothing in it
begin;
BEGIN
declare keep_cursor_2 cursor with hold for select 42;
DECLARE CURSOR
commit;
COMMIT
begin;
BEGIN
rollback;
ROLLBACK
