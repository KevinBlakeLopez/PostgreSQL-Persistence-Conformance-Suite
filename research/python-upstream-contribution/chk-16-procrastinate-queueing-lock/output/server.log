	CREATE FUNCTION procrastinate_trigger_abort_requested_events_procedure_v1()
	    RETURNS trigger
	    LANGUAGE plpgsql
	AS $$
	BEGIN
	    INSERT INTO procrastinate_events(job_id, type)
	        VALUES (NEW.id, 'abort_requested'::procrastinate_job_event_type);
	    RETURN NEW;
	END;
	$$;
	
