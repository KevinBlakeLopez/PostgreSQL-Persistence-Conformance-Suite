	DROP TRIGGER IF EXISTS procrastinate_trigger_status_events_update ON procrastinate_jobs;
	DROP TRIGGER IF EXISTS procrastinate_jobs_notify_queue ON procrastinate_jobs;
	
	-- Delete the unversioned functions
