{
  "name": "ppcs/php-adapters",
  "description": "PPCS PHP adapters: a PDO PostgreSQL control and Laravel's Illuminate database connection. Not a Laravel application.",
  "license": "MIT",
  "require": {
    "php": "8.5.6",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "illuminate/database": "13.38.0",
    "illuminate/filesystem": "13.38.0"
  },
  "autoload": {
    "psr-4": {
      "Ppcs\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.5.6"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
