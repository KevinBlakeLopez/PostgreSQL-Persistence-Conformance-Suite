<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ppcs.EfCore</RootNamespace>
    <AssemblyName>Ppcs.EfCore</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="test/**" />
    <Content Remove="test/**" />
    <EmbeddedResource Remove="test/**" />
    <None Remove="test/**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\dotnet\Protocol.cs" Link="Shared\Protocol.cs" />
    <Compile Include="..\dotnet\Errors.cs" Link="Shared\Errors.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>
</Project>
