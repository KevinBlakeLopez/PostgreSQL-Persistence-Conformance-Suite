{
  "manifest": "ppcs-adapter/1",
  "name": "pg-control",
  "framework": "pg-control",
  "description": "Positive and negative controls: transactions written directly against node-postgres. `correct` checks PostgreSQL's reply to COMMIT and reports a COMMIT error as a failure; `unsafe` deliberately gets these wrong. Used to show that the runner passes a known-good implementation and detects a known-bad one. `expectations` states each mode's expected classification per case; a framework's result for a case counts only when these hold in the same run.",
  "command": [
    "node",
    "main.mjs"
  ],
  "shared": [
    "../node-kit"
  ],
  "modes": [
    {
      "id": "correct",
      "kind": "control",
      "description": "Positive control: reads the command tag of PostgreSQL's reply to COMMIT, reports a COMMIT error as a failure, and discards a connection whose ROLLBACK failed. It starts a transaction at the isolation level requested of it."
    },
    {
      "id": "unsafe",
      "kind": "control",
      "description": "Negative control: ignores the command tag of the reply to COMMIT, reports any COMMIT error as a rollback, ignores failed savepoint rollbacks, returns a connection whose ROLLBACK failed to its pool as it is, and defers a write made before a nested scope into that scope's savepoint. It starts every transaction with a plain BEGIN, ignoring a requested isolation level."
    }
  ],
  "implements": [
    "CTL-01.commit",
    "CTL-01.rollback",
    "TX-01A.caught-error-then-commit",
    "TX-01B.conn-lost-before-commit",
    "TX-01B.commit-reply-discarded",
    "TX-01B.commit-reply-unseen",
    "TX-03.rollback-not-sent",
    "TX-03.statement-error-rollback-not-sent",
    "TX-03.conn-lost-in-transaction",
    "TX-02.savepoint-rollback-not-sent",
    "TX-02.savepoint-rollback-rejected",
    "TX-02.conn-lost-before-savepoint-rollback",
    "TX-04.nested-failure-contained",
    "TX-04.nested-released-outer-rollback",
    "TX-05.managed-serializable",
    "TX-05.explicit-serializable",
    "MG-02.held",
    "MG-02.first-deployment",
    "MG-02.session-loss",
    "MG-02.idle-session-timeout",
    "MG-03.valid-reversal",
    "MG-03.no-reversal",
    "MG-03.failing-reversal"
  ],
  "history": { "table": "ppcs_history", "column": "name" },
  "rollback_claim_channels": [
    "result"
  ],
  "expectations": {
    "CTL-01.commit": {
      "correct": "PASS",
      "unsafe": "PASS"
    },
    "CTL-01.rollback": {
      "correct": "PASS",
      "unsafe": "PASS"
    },
    "TX-01A.caught-error-then-commit": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-01B.conn-lost-before-commit": {
      "correct": "PASS",
      "unsafe": "PASS"
    },
    "TX-01B.commit-reply-discarded": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-01B.commit-reply-unseen": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-02.savepoint-rollback-not-sent": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-02.savepoint-rollback-rejected": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-02.conn-lost-before-savepoint-rollback": {
      "correct": "PASS",
      "unsafe": "PASS"
    },
    "TX-03.rollback-not-sent": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-03.statement-error-rollback-not-sent": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-03.conn-lost-in-transaction": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-04.nested-failure-contained": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-04.nested-released-outer-rollback": {
      "correct": "PASS",
      "unsafe": "PASS"
    },
    "TX-05.managed-serializable": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "TX-05.explicit-serializable": {
      "correct": "PASS",
      "unsafe": "FAIL"
    },
    "MG-02.held": { "correct": "PASS", "unsafe": "FAIL" },
    "MG-02.first-deployment": { "correct": "PASS", "unsafe": "FAIL" },
    "MG-02.session-loss": { "correct": "PASS", "unsafe": "FAIL" },
    "MG-02.idle-session-timeout": { "correct": "PASS", "unsafe": "FAIL" },
    "MG-03.valid-reversal": { "correct": "PASS", "unsafe": "FAIL" },
    "MG-03.no-reversal": { "correct": "PASS", "unsafe": "FAIL" },
    "MG-03.failing-reversal": { "correct": "PASS", "unsafe": "FAIL" }
  },
  "unsupported": {
    "TX-04.independent-inner": {
      "class": "not-applicable-by-design",
      "reason": "The control has no propagation modes, so it has no API that promises an independent inner transaction, and the hazard TX-04.3 targets (pending outer writes committed by the inner transaction) cannot arise."
    }
  }
}
