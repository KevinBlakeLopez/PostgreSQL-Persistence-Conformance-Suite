  "specification": {
    "id": "CTL-01.rollback",
    "version": "1.1",
    "family": "CTL-01",
    "family_title": "Observation controls",
    "family_version": "1.0",
    "kind": "control",
    "title": "A transaction writes a marker and fails with an application error",
    "steps": [
      "Start a transaction with the framework's ordinary transaction API.",
      "Write the marker `tx`.",
      "Checkpoint `before-end`: report pg_current_xact_id() and pg_backend_pid().",
      "Raise an application error inside the transaction, so that the framework rolls it back.",
      "Checkpoint `after-end`, as soon as the API has returned: the runner records the state at report time."
    ],
    "invariants": [
      {
        "id": "CTL-01.2",
        "statement": "A transaction that the API reports as rolled back is not committed: pg_xact_status() reports it aborted, and an independent connection does not see its marker."
      }
    ],
    "catalog": "specifications",
    "catalog_sha256": "b504ba4a1b60b5ab50e83f83df1bb66b9aab1e7d8429670852dbada03ea853d2"
