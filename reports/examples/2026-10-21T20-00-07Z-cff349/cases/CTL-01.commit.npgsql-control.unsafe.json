  "execution": {
    "mode": "unsafe",
    "kind": "configured",
    "description": "Negative control. CommitAsync returning is reported as committed, with no probe. A thrown CommitAsync is reported as rolled_back. A failed RollbackAsync(savepoint) is ignored and the outer transaction is committed. A thrown RollbackAsync is followed by CommitAsync, and the connection is kept. IsolationLevel is not passed. A write made before a savepoint is executed inside that savepoint. Pooling is off.",
    "configuration": {
      "commit_outcome": "committed whenever CommitAsync returns",
      "commit_error": "reported as rolled_back",
      "failed_savepoint_rollback": "ignored; CommitAsync",
      "failed_rollback": "CommitAsync; connection kept",
      "isolation_level": "not passed",
      "write_before_savepoint": "sent inside the savepoint",
      "command_tag": "not exposed by NpgsqlTransaction.CommitAsync",
      "connections": "one NpgsqlConnection, pooling off"
    },
    "form": "NpgsqlConnection.BeginTransactionAsync, parameterized commands, then CommitAsync or RollbackAsync. One connection is held until the case's after-end checkpoint, unless the policy disposed it."
  },
  "configuration": {
    "pool_max": 1
  },
