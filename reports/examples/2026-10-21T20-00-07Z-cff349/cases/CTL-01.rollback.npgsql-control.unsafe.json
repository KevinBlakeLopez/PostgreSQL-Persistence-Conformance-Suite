  "fault": {
    "category": "none"
  },
  "knowledge": "The framework rolls the transaction back, and PostgreSQL confirms the ROLLBACK, so the client knows that nothing committed.",
  "api_outcome": {
    "reported": "rolled_back",
    "basis": "the body threw and NpgsqlTransaction.RollbackAsync returned",
    "contract": "The unsafe npgsql-control policy reports committed whenever NpgsqlTransaction.CommitAsync returns. It does not probe the session and does not read a command tag. It reports rolled_back when CommitAsync throws. It calls CommitAsync after RollbackAsync(savepoint) has thrown. When RollbackAsync throws, it calls CommitAsync and keeps the connection. That is the mistake of clearing an open transaction by committing it. It does not pass an IsolationLevel to BeginTransactionAsync. A write made before a nested savepoint is executed inside that savepoint.",
    "error": {
      "class": "AppException",
      "code": null,
      "message": "application error: the request fails"
    },
    "steps": {
      "body_error": {
        "class": "AppException",
        "code": null,
        "message": "application error: the request fails"
      }
    }
  },
