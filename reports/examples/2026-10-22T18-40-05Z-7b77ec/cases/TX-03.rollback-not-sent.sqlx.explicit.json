  "fault": {
    "category": "C",
    "mechanism": "A client-side injection in the adapter's driver layer (node-postgres, pg.Client.prototype.query): the top-level ROLLBACK fails without being sent, as a failed send would.",
    "injection_point": "The framework's ROLLBACK of unit 1.",
    "preconditions": "The framework's statements pass through the instrumented pg module (recorded as trace_sees_framework_pg).",
    "expected_server": "Unit 1's transaction stays open on its connection (\"idle in transaction\"), holding the doomed write.",
    "expected_client": "An error from the framework's rollback; what the framework then does with the connection is under test.",
    "depends_on_internals": true
  },
  "knowledge": "The framework knows that its ROLLBACK failed, so it knows that the connection's transaction state is unknown.",
  "api_outcome": {
    "reported": "failed",
    "basis": "Transaction::rollback returned an error, so the API did not report a completed rollback",
    "contract": "sqlx 0.9.0 Transaction::commit (sqlx-core/src/transaction.rs) returns Ok after PgTransactionManager::commit returns. That method (sqlx-postgres/src/transaction.rs) executes COMMIT, or RELEASE SAVEPOINT when nested, and returns Ok when execute returns Ok. PgConnection::run records CommandComplete only as rows_affected (sqlx-postgres/src/connection/executor.rs). A command tag of ROLLBACK is not an error. Transaction::rollback returns Ok when ROLLBACK or ROLLBACK TO SAVEPOINT returns Ok, and returns that statement's error otherwise. On that error the Transaction is still open, so Drop calls start_rollback, which queues a second rollback and does not wait.",
    "error": {
      "class": "sqlx::Error",
      "code": "XX000",
      "message": "error returned from database: injected client-side failure: statement was not sent"
    },
