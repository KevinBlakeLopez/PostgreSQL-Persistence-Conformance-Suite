    "family": "CTL-01",
    "family_title": "Observation controls",
    "family_version": "1.0",
    "kind": "control",
    "title": "A transaction writes a marker and commits",
    "steps": [
      "Start a transaction with the framework's ordinary transaction API.",
      "Write the marker `tx` through the framework's ordinary write API.",
      "Checkpoint `before-end`: report pg_current_xact_id() and pg_backend_pid(), read through the transaction's own connection.",
      "End the transaction normally, so that the framework commits it.",
      "Checkpoint `after-end`, as soon as the API has returned: the runner records the state at report time."
    ],
    "invariants": [
      {
        "id": "CTL-01.1",
        "statement": "A transaction that the API reports as committed is committed: pg_xact_status() reports it committed, and an independent connection sees its marker."
      }
    ],
