    "kind": "native",
    "description": "sql.DB.BeginTx, sql.Tx.Commit, and sql.Tx.Rollback. sql.TxOptions.Isolation is set for TX-05. A nil Commit error is reported as committed. pgx.ErrTxCommitRollback is reported as rolled_back. Any other Commit or Rollback error is reported as failed. The pool is database/sql, not pgxpool. stdlib ResetSession still returns driver.ErrBadConn when the pgx transaction status is not idle.",
    "configuration": {
      "api": "sql.DB.BeginTx, sql.Tx.Commit, and sql.Tx.Rollback",
      "driver": "pgx stdlib wrapTx.Commit calls pgx.Tx.Commit",
      "nested": "SAVEPOINT / ROLLBACK TO SAVEPOINT / RELEASE SAVEPOINT as SQL. database/sql has no savepoint type.",
      "pool": "database/sql pool, MaxOpenConns = pool_max"
    },
    "form": null
  },
