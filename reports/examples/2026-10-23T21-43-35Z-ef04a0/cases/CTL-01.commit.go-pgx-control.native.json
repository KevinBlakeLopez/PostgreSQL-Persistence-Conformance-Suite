  "execution": {
    "mode": "native",
    "kind": "native",
    "description": "pgx.Conn.BeginTx, Tx.Commit, and Tx.Rollback on one connection. A nested Tx.Begin is a savepoint. Tx.Commit's return value is reported as the API result: nil is committed, pgx.ErrTxCommitRollback is rolled_back, and any other error is failed. Pooling is not used. After Conn.die closes the connection, the next transaction dials a replacement.",
    "configuration": {
      "api": "pgx.Tx.Begin, Commit, and Rollback",
      "nested": "pgx.Tx.Begin is a savepoint",
      "pgx": "v5.11.0",
      "pool": "single *pgx.Conn, replaced only after pgx closes it"
    },
    "form": null
