  "execution": {
    "mode": "unsafe",
    "kind": "configured",
    "description": "Negative control. Connection.commit() returning is reported as committed, including when the driver state was FAILED. A thrown commit() is reported as rolled_back. A failed Connection.rollback(Savepoint) is ignored and the outer transaction is committed. A thrown Connection.rollback() is followed by Connection.setAutoCommit(true), and the connection is kept. Connection.setTransactionIsolation is not called. A write made before a savepoint is executed inside that savepoint. One DriverManager connection is held. It is not a pool.",
    "configuration": {
      "commit_outcome": "committed whenever Connection.commit() returns",
      "commit_error": "reported as rolled_back",
      "failed_savepoint_rollback": "ignored; Connection.commit()",
      "failed_rollback": "setAutoCommit(true); connection kept",
      "isolation_level": "not called",
      "write_before_savepoint": "sent inside the savepoint",
      "connections": "DriverManager, one connection, no pool"
    },
    "form": "Connection.setAutoCommit(false), the work, then Connection.commit() or Connection.rollback(). Writes use PreparedStatement."
  },
  "configuration": {
    "pool_max": 1
  },
