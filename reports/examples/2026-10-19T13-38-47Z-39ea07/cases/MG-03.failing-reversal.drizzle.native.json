    "family": "MG-03",
    "family_title": "Rollback and history consistency",
    "family_version": "1.0",
    "kind": "scenario",
    "title": "A transactional migration's reversal deletes its marker and then fails",
    "steps": [
      "Runner A applies { m1 }.",
      "Revert. m1's reversal deletes its marker and then raises an error. The migration is transactional, so the deletion is in the reversal's transaction.",
      "Checkpoint `after-end`, as soon as the revert has returned: the runner records the state at report time."
    ],
    "invariants": [
      {
        "id": "MG-03.3",
        "statement": "If a migration's reversal fails, the operation reports failure and the migration's history entry remains; for a transactional migration, its marker also remains."
      }
    ],
