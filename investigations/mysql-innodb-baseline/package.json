{
  "name": "mpcs-mysql-innodb-baseline",
  "private": true,
  "version": "0.0.0",
  "description": "Standalone MySQL 8.4 / InnoDB transaction baseline for a possible MySQL Persistence Conformance suite. Not a PPCS adapter.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "baseline": "node src/run-all.mjs",
    "knex": "node src/run-knex.mjs",
    "lucid": "node src/run-lucid.mjs",
    "lost-commit": "node src/run-lost-commit.mjs",
    "suite": "node src/run-suite.mjs",
    "php-mx01": "node src/run-php-mx01.mjs",
    "php-concurrency": "node src/run-php-concurrency.mjs",
    "php-update-batch": "node src/run-php-update-batch.mjs",
    "php-connection": "node src/run-php-connection.mjs",
    "php-nested": "node src/run-php-nested.mjs",
    "php-ddl": "node src/run-php-ddl.mjs",
    "php-model": "node src/run-php-model.mjs"
  },
  "dependencies": {
    "@adonisjs/core": "7.6.0",
    "@adonisjs/lucid": "22.4.2",
    "knex": "3.3.0",
    "luxon": "3.7.2",
    "mysql2": "3.24.6"
  }
}
